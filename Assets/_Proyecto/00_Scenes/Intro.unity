  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7385f741c1cc1c4f97a7025a1c64aa3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PantallaHistoria
  textoPagina: {fileID: 1447956544}
  textoAyuda: {fileID: 359455842}
  paginas:
  - "Inti y Killa son hermanos. \xC9l lleva el fuego del Sol; ella, el agua de la
    Luna."
  - "Viajaban juntos por Bolivia cuando un eclipse oscureci\xF3 el cielo... y se
    perdieron lejos de casa."
  - "Para volver a la Isla del Sol deber\xE1n cruzar el salar, las minas, los Yungas,
    el tr\xF3pico y Aiquile."
  - "Solo podr\xE1n llegar si se ayudan: lo que a uno lo salva, al otro lo puede
    destruir."
  - "Un consejo antes de empezar: no conf\xEDes en nada... ni en tu compa\xF1ero."
  escenaSiguiente: SeleccionMundo
  segundosDeAparicion: 0.8
