  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7385f741c1cc1c4f97a7025a1c64aa3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PantallaHistoria
  textoPagina: {fileID: 1583067408}
  textoAyuda: {fileID: 1742446868}
  paginas:
  - "Hace mucho tiempo, Inti, el Sol, y Killa, la Luna, cuidaban juntos el equilibrio
    entre el d\xEDa y la noche."
  - "Pero un eclipse sin fin rompi\xF3 ese equilibrio, y las gemas de luz se esparcieron
    por toda Bolivia."
  - "Desde el Salar de Uyuni hasta la Isla del Sol, Inti y Killa deber\xE1n recuperarlas...
    juntos."
  - "Un consejo antes de empezar: no conf\xEDes en nada... ni en tu compa\xF1ero."
  escenaSiguiente: MenuPrincipal
  segundosDeAparicion: 0.8
